---
import Layout from "../../layouts/Layout.astro";
import RaceMap from "../../components/RaceMap.astro";
import { races } from "../../data/races";

export function getStaticPaths() {
  return races.map((race) => ({
    params: { slug: race.slug },
    props: { race },
  }));
}

const { race } = Astro.props;

const dateLabel = race.endDate
  ? `${race.date} → ${race.endDate}`
  : race.date;

const statRows = race.stats
  ? [
      { label: "Edición", value: race.stats.edition },
      { label: "Inscriptos", value: race.stats.participants },
      { label: "Países", value: race.stats.countries },
      { label: "Mejor tiempo", value: race.stats.bestTime },
    ].filter((s) => s.value)
  : [];
---

<Layout
  title={`${race.name} — PIQUE`}
  description={`Ficha de ${race.name}: fecha, distancias, ubicación e inscripción.`}
>
  <header class="page-header">
    <div class="wrap">
      <a class="back-link" href="/calendario">← Volver al calendario</a>
      <span class="eyebrow">{dateLabel} · {race.city}</span>
      <h1 class="display">{race.name}</h1>
    </div>
  </header>

  <section class="block" style="border-bottom: none;">
    <div class="wrap">
      <div class="ficha-grid">
        <div class="ficha-main">
          <div class="fact-strip">
            <div class="fact">
              <span class="lbl">Distancias</span>
              <span class="val mono">{race.distances}</span>
            </div>
            <div class="fact">
              <span class="lbl">Tipo</span>
              <span class="tag">{race.tag}</span>
            </div>
            <div class="fact">
              <span class="lbl">Organizador</span>
              <span class="val organizer-val">{race.organizer}</span>
            </div>
            {
              race.startPoint && (
                <div class="fact">
                  <span class="lbl">Largada</span>
                  <span class="val organizer-val">{race.startPoint}</span>
                </div>
              )
            }
            {
              race.startTime && (
                <div class="fact">
                  <span class="lbl">Horario</span>
                  <span class="val mono">{race.startTime}</span>
                </div>
              )
            }
          </div>

          <RaceMap lat={race.lat} lng={race.lng} label={race.name} />

          {
            statRows.length > 0 && (
              <div class="info-card">
                <span class="eyebrow">Última edición</span>
                <div class="stat-row">
                  {statRows.map((s) => (
                    <div class="stat">
                      <span class="stat-val mono">{s.value}</span>
                      <span class="stat-lbl">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {
            race.highlights && (
              <div class="info-card">
                <span class="eyebrow">Sobre la carrera</span>
                <p class="info-text">{race.highlights}</p>
              </div>
            )
          }

          {
            race.kitPickup && (
              <div class="info-card">
                <span class="eyebrow">Retiro de kit</span>
                <p class="info-text">{race.kitPickup}</p>
              </div>
            )
          }

          {
            race.contact && (
              <p class="contact-line">
                <span class="eyebrow">Contacto</span> {race.contact}
              </p>
            )
          }
        </div>

        <aside class="ficha-side">
          <a
            class="btn btn-primary"
            href={race.infoUrl}
            target="_blank"
            rel="noopener"
          >
            Más info e inscripción →
          </a>
          <p class="source-note" style="margin-top: 16px;">
            Para inscribirte, confirmar el precio exacto o ver el reglamento
            completo, entrá al link de arriba — es la página oficial del
            organizador. El resto de los datos de esta ficha se actualizó a
            mano el 2026-08-07.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    margin-bottom: 18px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .ficha-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .ficha-grid {
      grid-template-columns: 1fr;
    }
  }
  .ficha-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .fact-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 22px 24px;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fact .lbl {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .fact .val {
    font-size: 17px;
    font-weight: 600;
  }
  .fact .organizer-val {
    font-family: "Work Sans", sans-serif;
  }

  .info-card {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 22px 24px;
  }
  .info-text {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .stat-row {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-val {
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
  }
  .stat-lbl {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contact-line {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
  }
  .contact-line .eyebrow {
    margin-right: 6px;
  }

  .ficha-side {
    position: sticky;
    top: 84px;
  }
  .ficha-side .btn {
    width: 100%;
    text-align: center;
  }
</style>
