---
---

<footer>
  <span class="footer-ghost" aria-hidden="true">PIQUE</span>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="logo" href="/">PIQUE</a>
        <p class="foot-tag">
          Calendario, calculadoras y rutas de running en Argentina. Hecho por
          corredores, para corredores.
        </p>
      </div>
      <div class="foot-social">
        <a href="#" aria-label="Instagram" title="Instagram">
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
              cx="12"
              cy="12"
              r="4"></circle><circle cx="17.2" cy="6.8" r="1"
            ></circle></svg
          >
        </a>
        <a href="#" aria-label="TikTok" title="TikTok">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M16.5 2h-3v13.5a3 3 0 1 1-2.5-2.96V9.4a6 6 0 1 0 5.5 5.98V9.2a7.3 7.3 0 0 0 4.5 1.55V7.7a4.3 4.3 0 0 1-4.5-4.2V2z"
            ></path></svg
          >
        </a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} PIQUE</span>
      <span>Buenos Aires, Argentina</span>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    overflow: hidden;
    padding: 56px 0 40px;
  }
  .footer-ghost {
    position: absolute;
    left: 50%;
    bottom: -0.22em;
    transform: translateX(-50%);
    font-family: "Oswald", sans-serif;
    font-weight: 700;
    font-size: min(18vw, 190px);
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1.4px var(--line);
    white-space: nowrap;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  footer .wrap {
    position: relative;
    z-index: 1;
  }
  .logo {
    font-family: "Oswald", system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .foot-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
  }
  .foot-tag {
    max-width: 34ch;
    color: var(--ink-soft);
    font-size: 14px;
    margin-top: 10px;
  }
  .foot-social {
    display: flex;
    gap: 14px;
  }
  .foot-social a {
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .foot-social a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .foot-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
    color: var(--ink-faint);
    font-family: "IBM Plex Mono", monospace;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
