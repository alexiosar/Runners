<section class="cta-band">
  <div class="wrap cta-band-inner">
    <div>
      <span class="eyebrow">Arrancá hoy</span>
      <h2 class="display">¿Vamos a<br />correr?</h2>
    </div>
    <a class="btn btn-primary" href="#calendario"
      >Buscar mi próxima carrera</a
    >
  </div>
</section>

<style>
  .cta-band {
    background: var(--accent);
    color: var(--accent-ink);
    clip-path: polygon(0 0, 100% 6.5%, 100% 100%, 0 100%);
    padding: 74px 0 78px;
  }
  .cta-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }
  .cta-band .eyebrow {
    color: var(--accent-ink);
    opacity: 0.78;
  }
  .cta-band h2 {
    margin: 10px 0 0;
    font-size: clamp(36px, 5.4vw, 60px);
    line-height: 0.95;
  }
  .btn-primary {
    background: var(--accent-ink);
    color: var(--accent-dim);
    font-weight: 700;
    flex-shrink: 0;
    font-size: 14.5px;
    text-decoration: none;
    padding: 13px 22px;
    border-radius: 3px;
    display: inline-block;
  }
</style>
