---
---

<section class="block" id="calculadora">
  <div class="wrap">
    <div class="block-head reveal">
      <div>
        <span class="eyebrow">Herramienta</span>
        <h2 class="display">Calculadora de ritmo</h2>
      </div>
      <a class="see-all" href="/circuito">Armar mi circuito →</a>
    </div>
    <div class="calc reveal">
      <div class="field">
        <label for="distSel">Distancia</label>
        <select id="distSel">
          <option value="5">5 km</option>
          <option value="10" selected>10 km</option>
          <option value="21.0975">21K · Media maratón</option>
          <option value="42.195">42K · Maratón</option>
        </select>
      </div>
      <div class="field field-time">
        <label for="timeH">Tiempo objetivo</label>
        <div class="timeinputs">
          <div class="time-field">
            <input
              type="number"
              id="timeH"
              min="0"
              max="23"
              value="0"
              aria-label="Horas"
            />
            <span class="time-unit">hs</span>
          </div>
          <span class="sep">:</span>
          <div class="time-field">
            <input
              type="number"
              id="timeM"
              min="0"
              max="59"
              value="50"
              aria-label="Minutos"
            />
            <span class="time-unit">min</span>
          </div>
          <span class="sep">:</span>
          <div class="time-field">
            <input
              type="number"
              id="timeS"
              min="0"
              max="59"
              value="0"
              aria-label="Segundos"
            />
            <span class="time-unit">seg</span>
          </div>
        </div>
      </div>
      <div class="calc-result">
        <span class="lbl">Tu ritmo</span>
        <span class="val" id="paceOut">5:00 /km</span>
      </div>
    </div>
  </div>
</section>

<script>
  const distSel = document.getElementById("distSel") as HTMLSelectElement;
  const hEl = document.getElementById("timeH") as HTMLInputElement;
  const mEl = document.getElementById("timeM") as HTMLInputElement;
  const sEl = document.getElementById("timeS") as HTMLInputElement;
  const out = document.getElementById("paceOut");

  function calc() {
    const dist = parseFloat(distSel.value);
    const h = parseInt(hEl.value, 10) || 0;
    const m = parseInt(mEl.value, 10) || 0;
    const s = parseInt(sEl.value, 10) || 0;
    const totalSec = h * 3600 + m * 60 + s;
    if (!out) return;
    if (!dist || totalSec <= 0) {
      out.textContent = "—";
      return;
    }
    const paceSecPerKm = totalSec / dist;
    let pm = Math.floor(paceSecPerKm / 60);
    let ps = Math.round(paceSecPerKm % 60);
    if (ps === 60) {
      ps = 0;
      pm += 1;
    }
    out.textContent = `${pm}:${String(ps).padStart(2, "0")} /km`;
  }

  [distSel, hEl, mEl, sEl].forEach((el) => {
    el.addEventListener("input", calc);
    el.addEventListener("change", calc);
  });

  // Si venimos de /circuito con una distancia armada a mano, la sumamos
  // como opción y la dejamos seleccionada.
  const customKm = parseFloat(
    new URLSearchParams(window.location.search).get("km") ?? "",
  );
  if (customKm > 0) {
    const opt = document.createElement("option");
    opt.value = String(customKm);
    opt.textContent = `${customKm.toFixed(2)} km · Tu circuito`;
    distSel.prepend(opt);
    distSel.value = String(customKm);
  }

  calc();
</script>

<style>
  .calc {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 32px;
    display: grid;
    grid-template-columns: 1fr 1.6fr auto;
    gap: 20px;
    align-items: start;
    box-shadow: var(--shadow);
  }
  @media (max-width: 700px) {
    .calc {
      grid-template-columns: 1fr;
      padding: 24px 20px;
    }
  }
  .field label {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }
  .field select,
  .field .timeinputs {
    width: 100%;
  }
  .field select {
    font: inherit;
    font-family: "IBM Plex Mono", monospace;
    font-size: 16px;
    padding: 11px 10px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink);
  }
  .timeinputs {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }
  .time-field {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .timeinputs input {
    font: inherit;
    font-family: "IBM Plex Mono", monospace;
    font-size: 16px;
    text-align: center;
    width: 100%;
    min-width: 0;
    padding: 11px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink);
  }
  .time-unit {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .timeinputs .sep {
    align-self: center;
    margin-top: 11px;
    color: var(--ink-faint);
    font-family: "IBM Plex Mono", monospace;
  }
  .calc-result {
    background: var(--ink);
    color: var(--bg);
    border-radius: 5px;
    padding: 13px 20px;
    text-align: center;
    min-width: 148px;
  }
  @media (max-width: 700px) {
    .calc-result {
      min-width: 0;
      width: 100%;
    }
  }
  .calc-result .lbl {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: block;
  }
  .calc-result .val {
    font-family: "IBM Plex Mono", monospace;
    font-size: 24px;
    font-weight: 600;
    color: var(--accent-dim);
  }
</style>
